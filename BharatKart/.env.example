# BharatKart Hyperlocal Marketplace — Configuration Template
# Copy this file to .env and insert your real credentials. Never commit .env to GitHub.

# Primary Datastore: Aiven PostgreSQL
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# Event Streaming: Aiven Apache Kafka
AIVEN_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:18241
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_TOPIC_PREFIX=bharatkart.
KAFKA_CONSUMER_GROUP=bharatkart-consumer-group

# Search Engine: Aiven OpenSearch
AIVEN_OPENSEARCH_ENABLED=false
OPENSEARCH_HOST=https://your-opensearch-host:18228
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=your-opensearch-password
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true

# Shopping Intelligence Assistant (Optional - Built-in rule-based AI functions offline without this key)
GEMINI_API_KEY=your-gemini-api-key

# Platform Parameters
FREE_SHIPPING_THRESHOLD=499.00
STANDARD_SHIPPING_FEE=49.00
LOW_STOCK_THRESHOLD=5
JWT_SECRET_KEY=bharatkart-super-secret-key-2026
