# Environment variables & secrets — NEVER commit secrets
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Certificates & Keys — NEVER commit credentials
certificates/
**/certificates/
*.pem
*.key
*.crt
*.cer

# Python & Caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
*.pyc

# Virtual environments
venv/
.venv/
env/
**/venv/
**/.venv/

# Streamlit secrets
.streamlit/secrets.toml
**/.streamlit/secrets.toml

# Local database files & sqlite
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

